{
  "image": "mcr.microsoft.com/devcontainers/base:2.2.5-trixie",
  "features": {
    "ghcr.io/Aire-One/devcontainer-features/lua:2.3.0": {},
    "ghcr.io/Aire-One/devcontainer-features/luarocks:2.0.0": {}
  },
  "postCreateCommand": "luarocks install --local --only-deps depgraph-scm-1.rockspec && luarocks install --local busted && luarocks install --local cluacov && luarocks install --local luacheck --dev",
  // This is the result of the `luarocks path` command. Adds the local luarocks path to the environment variables.
  "remoteEnv": {
    "LUA_PATH": "/usr/local/share/lua/5.5/?.lua;/usr/local/share/lua/5.5/?/init.lua;/usr/local/lib/lua/5.5/?.lua;/usr/local/lib/lua/5.5/?/init.lua;./?.lua;./?/init.lua;/home/vscode/.luarocks/share/lua/5.5/?.lua;/home/vscode/.luarocks/share/lua/5.5/?/init.lua",
    "LUA_CPATH": "/usr/local/lib/lua/5.5/?.so;/usr/local/lib/lua/5.5/loadall.so;./?.so;/home/vscode/.luarocks/lib/lua/5.5/?.so",
    "PATH": "/home/vscode/.luarocks/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "sumneko.lua",
        "dwenegar.vscode-luacheck",
        "github.vscode-github-actions"
      ]
    }
  }
}
